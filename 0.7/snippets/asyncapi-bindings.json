{
  "servers": {
    "kafka": {
      "bindings": {
        "kafka": {
          "schemaRegistryUrl": "http://registry.internal:8081",
          "schemaRegistryVendor": "confluent",
          "bindingVersion": "0.5.0"
        }
      }
    }
  },
  "channels": {
    "orders": {
      "bindings": {
        "kafka": {
          "topic": "orders",
          "bindingVersion": "0.5.0"
        }
      }
    }
  },
  "operations": {
    "receive_orders": {
      "bindings": {
        "kafka": {
          "groupId": { "type": "string", "enum": ["orders-svc"] },
          "clientId": { "type": "string", "enum": ["orders-reader"] },
          "bindingVersion": "0.5.0"
        }
      }
    }
  }
}
